@startuml

'==================== ENUM ====================
enum FuelType {
  HYBRID
  ELECTRIC
  MECHANICAL
}

'==================== BASE ====================
abstract class Vehicle {
    -brand : String
    -model : String
    -plate : String
    -year : int
    -fuelType : FuelType
    -status : String
    -mileage : double
    -price : double
    -maintenances : List<Maintenance>
    +addMaintenance(m: Maintenance)
    +createIterator() : Iterator
    +showType()
}

'==================== INTERFACES ====================
interface CasualVehicle {
    +useType()
}

interface HeavyVehicle {
    +useType()
}

interface OffRoadVehicle {
    +useType()
}

'==================== ABSTRACT FACTORY ====================
interface VehicleFactory {
    +createCasualVehicle() : CasualVehicle
    +createHeavyVehicle() : HeavyVehicle
    +createOffRoadVehicle() : OffRoadVehicle
}

'==================== CLASES ====================
class HybridCasualVehicle
class HybridHeavyVehicle
class HybridOffRoadVehicle

class ElectricCasualVehicle
class ElectricHeavyVehicle
class ElectricOffRoadVehicle

class MechanicalCasualVehicle
class MechanicalHeavyVehicle
class MechanicalOffRoadVehicle

class HybridFactory
class ElectricFactory
class MechanicalFactory

'==================== RELATIONSHIPS ====================

' Herencia base (Vehicle)
Vehicle <|-- HybridCasualVehicle
Vehicle <|-- HybridHeavyVehicle
Vehicle <|-- HybridOffRoadVehicle
Vehicle <|-- ElectricCasualVehicle
Vehicle <|-- ElectricHeavyVehicle
Vehicle <|-- ElectricOffRoadVehicle
Vehicle <|-- MechanicalCasualVehicle
Vehicle <|-- MechanicalHeavyVehicle
Vehicle <|-- MechanicalOffRoadVehicle

' Implementación de interfaces (tipo de uso)
CasualVehicle <|.. HybridCasualVehicle
HeavyVehicle <|.. HybridHeavyVehicle
OffRoadVehicle <|.. HybridOffRoadVehicle

CasualVehicle <|.. ElectricCasualVehicle
HeavyVehicle <|.. ElectricHeavyVehicle
OffRoadVehicle <|.. ElectricOffRoadVehicle

CasualVehicle <|.. MechanicalCasualVehicle
HeavyVehicle <|.. MechanicalHeavyVehicle
OffRoadVehicle <|.. MechanicalOffRoadVehicle

' Fábricas
VehicleFactory <|-- HybridFactory
VehicleFactory <|-- ElectricFactory
VehicleFactory <|-- MechanicalFactory

' Dependencias (creación)
HybridFactory --> HybridCasualVehicle
HybridFactory --> HybridHeavyVehicle
HybridFactory --> HybridOffRoadVehicle

ElectricFactory --> ElectricCasualVehicle
ElectricFactory --> ElectricHeavyVehicle
ElectricFactory --> ElectricOffRoadVehicle

MechanicalFactory --> MechanicalCasualVehicle
MechanicalFactory --> MechanicalHeavyVehicle
MechanicalFactory --> MechanicalOffRoadVehicle

@enduml