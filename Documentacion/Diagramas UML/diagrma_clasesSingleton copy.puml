@startuml
'Observer(Objetos: Vehiculo, reserva / sujetos: Administrador, Cliente *Los observadores, cliente y administrador, se les envia notficicaciones sobre el estado de la reserva y el vehiculo*) -  command(reserva tendria fus funciones desacopladas de la clase, crearReserva, CancelarReserva, EditarReserva)- singleton(Para poder generar solo una instancia por cada vez q se cree un objeto en la clase notificacion. Ademas de crear una unica instancia para las reservas y vehiculos.) - strategy(Se necesitan para en el tiempo de ejecucion se le pueda ofrecer al cliente una serie de estrategias de pago.)- factory-method(se emplearia para la creacion de distintos tipos de vehiculos)'

'' command(creaR) - memento-  factory method '

left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 100
skinparam ranksep 100

'OBSERVER
package "Observer" {

interface Observador {
    +actualizar(mensaje: String)
}

interface Sujeto {
    +agregarObservador(o: Observador)
    +eliminarObservador(o: Observador)
    +notificar(mensaje: String)
}

class Notificaciones <<singleton>> {
    - instancia : static
    + getInstance() : Notificaciones
    +enviar(mensaje: String) 
}


class Administrador{
    +actualizar(message: String)
}

class Cliente{
    +actualizar(message: String)
}

}

'STRATEGY
package "Strategy (Pago)" {

interface MetodoPago {
    +pagar(monto : double)
}

class TarjetaCredito  {
    +pagar(monto : double)
}

class TarjetaDebito  {
    +pagar(monto : double)
}

class Pago {
    -fechaPago : Date
    -monto : double
    +realizarPago()
}

}


'command
package  "command" {
    interface Comando {
    +ejecutar()
}

class Invocador {
    -historial : List<Comando>
    +ejecutarComando(c: Comando)
}


class CrearReservaCommand {
    -reserva : Reserva
    +ejecutar()
}

class CancelarReservaCommand {
    -reserva : Reserva
    +ejecutar()
}

}
'ITERATOR
package "Iterator" {
    interface Iterador{
    +hasNext() : boolean
    +next() : object

}

interface Agregado {
    +crearIterador() : Iterador
}

class IteradorMantenimientos {
    -mantenimientos : List<Mantenimiento>
    -posicion : int
    +hasNext() : boolean
}
}

'FACTORY METHOD
package "Factory Method" {

abstract class Vehiculo {
    -marca : String
    -modelo : String
    -placa : String
    -anio : int
    -tipoCombustible : String
    -estado : String
    -kilometraje : double
    -precio : double
    -mantenimientos: List <Mantenimiento>
    +agregarMatenimiento(: mantenimiento)
}

class VehiculoPesado  {
    -tonelaje: double
    -numEjes: int
    -tieneRemolque: boolean
}
class VehiculoCasual  {
    -numPuertas: int
    -transmision: String
    -tieneSunroof: boolean
}
class VehiculoDuro {
    -traccion: String
    -capCarga: double
    -tieneBlindaje: boolean
}

}

'SINGLETON
package "Singleton" {

class VehiculoManager <<Singleton>> {
    -vehiculos : List<Vehiculo>
    +agregarVehiculo()
    +obtenerVehiculos()
}

class ReservaManager <<Singleton>> {
    -reservas : List<Reserva>
    +crearReserva()
}

}

'dominio
package "Dominio" {
class Mantenimiento {
    -fechaInicio : Date
    -fechaFin : Date
    -estado : String
    -tipoMantenimiento : String
    +cambiarEstado()
    +notificarCambio()
}

class Seguro{
    -fechaVencimiento
    -vehiculo
    -notificaciones : Notificaciones
    +actualizarPago()
    +notificarVencimiento()
}

class Sucursal {
    -nombre : String
    -direccion : String
    -ciudad : String
    -telefono : String
    -horarios : String
    -Vehiculos : List <Vehiculo>
    +agregarVehiculo()
}

class Usuario {
    -nombreUsuario : String
    -correo : String
    -telefono : String
    -contraseña : String
    -tipoUsuario : String
    +actualizar(message: String)
}

class GPS {
    -latitud : double
    -longitud : double
    +obtenerUbicacionActual(): String
    +registrarRuta(ruta: Ruta)
}

class Ruta {
    -origen: String
    -destino: String
    -recorrido: List<String>
    -tiempoTotal: float
}

class Alquiler {
    -fechaInicio: Date
    -fechaFin: Date
    -cliente: Cliente
    -vehiculo: Vehiculo
    -ruta: List <Ruta>
    -notificaciones : Notificaciones
    +notificarInicioAlquiler()
    +notificarFinAlquiler()
    +agregarRuta()
}

class Reserva {
    - cliente : Cliente
    - vehiculo : Vehiculo
    -nombreResponsable : String
    -fechaInicio : Date
    -fechaFin : Date
    -lugarRetiro : String
    -lugarDevolucion : String
    -horaRetiro : String
    -horaDevolucion : String
    -valorTotal : double
    -notificaciones : Notificaciones
    +calcularValorTotal()
    +notificarProximaReserva()
}

class Contrato {
    -fechaContrato : Date
    -estadoVehiculoSalida : String
    -estadoVehiculoRegreso : String
    -condiciones : String
    -montoAPagar : double
}

}

'RELACIONES
'==================== RELACIONES CORRECTAS ====================

'Observer
Administrador ..|> Observador
Cliente ..|> Observador

Reserva ..|> Sujeto
Mantenimiento ..|> Sujeto
Seguro ..|> Sujeto

Sujeto --> Observador
Sujeto --> Notificaciones

'Command
CrearReservaCommand ..|> Comando
CancelarReservaCommand ..|> Comando
Invocador --> Comando
Comando --> Reserva

'Strategy
TarjetaCredito ..|> MetodoPago
TarjetaDebito ..|> MetodoPago
Pago --> MetodoPago

'Iterator
IteradorMantenimientos ..|> Iterador
Vehiculo ..|> Agregado
IteradorMantenimientos --> Mantenimiento

'Factory
Vehiculo <|-- VehiculoPesado
Vehiculo <|-- VehiculoCasual
Vehiculo <|-- VehiculoDuro

'Singleton (ajustado sin romper nombres)
VehiculoManager --> Vehiculo
ReservaManager --> Reserva

'Dominio (CONSISTENTE Y LIMPIO)
Usuario <|-- Cliente
Usuario <|-- Administrador

Sucursal --> Vehiculo
Vehiculo --> Mantenimiento

Cliente --> Reserva
Reserva --> Vehiculo
Reserva --> Contrato
Contrato --> Pago
Contrato --> Seguro

Vehiculo --> GPS
GPS --> Ruta

'Alquiler SIN saturar Vehiculo
Alquiler --> Cliente
Alquiler --> Ruta
Alquiler --> Reserva
@enduml