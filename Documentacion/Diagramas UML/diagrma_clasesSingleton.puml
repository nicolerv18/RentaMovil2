@startuml
'Observer(Objetos: Vehiculo, reserva / sujetos: Administrador, Cliente *Los observadores, cliente y administrador, se les envia notficicaciones sobre el estado de la reserva y el vehiculo*) -  command(reserva tendria fus funciones desacopladas de la clase, crearReserva, CancelarReserva, EditarReserva)- singleton(Para poder generar solo una instancia por cada vez q se cree un objeto en la clase notificacion. Ademas de crear una unica instancia para las reservas y vehiculos.) - strategy(Se necesitan para en el tiempo de ejecucion se le pueda ofrecer al cliente una serie de estrategias de pago.)- factory-method(se emplearia para la creacion de distintos tipos de vehiculos)'

'' command(creaR) - memento-  factory method '

left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle

'OBSERVER
package "Observer" {

interface Observador {
    +actualizar(mensaje: String)
}

interface Sujeto {
    +agregarObservador(o: Observador)
    +eliminarObservador(o: Observador)
    +notificar(mensaje: String)
}

class Notificaciones {
    - instancia : static
    + getInstance() : Notificaciones
    +enviar(mensaje: String)
}


class Administrador{
    +actualizar(message: String)
}

class Cliente{
    +actualizar(message: String)
}

}

'SINGLETON
package "Singleton" {

class VehiculoManager <<Singleton>> {
    -vehiculos : List<Vehiculo>
    +agregarVehiculo()
    +obtenerVehiculos()
}

class ReservaManager <<Singleton>> {
    -reservas : List<Reserva>
    +crearReserva()
}

}

'STRATEGY
package "Strategy (Pago)" {

interface MetodoPago {
    +pagar(monto : double)
}

class TarjetaCredito  {
    +pagar(monto : double)
}

class TarjetaDebito  {
    +pagar(monto : double)
}

class Pago {
    -fechaPago : Date
    -monto : double
    +realizarPago()
}

}

'FACTORY METHOD
package "Factory Method" {

abstract class Vehiculo {
    -marca : String
    -modelo : String
    -placa : String
    -anio : int
    -tipoCombustible : String
    -estado : String
    -kilometraje : double
    -precio : double
    -mantenimientos: List <Mantenimiento>
    +agregarMatenimiento(: mantenimiento)
}

class VehiculoPesado  {
    -tonelaje: double
    -numEjes: int
    -tieneRemolque: boolean
}
class VehiculoCasual  {
    -numPuertas: int
    -transmision: String
    -tieneSunroof: boolean
}
class VehiculoDuro {
    -traccion: String
    -capCarga: double
    -tieneBlindaje: boolean
}

}

'ITERATOR
package "Iterator" {
    interface Iterador{
    +hasNext() : boolean
    +next() : object

}

interface Agregado {
    +crearIterador() : Iterador
}

class IteradorMantenimientos {
    -mantenimientos : List<Mantenimiento>
    -posicion : int
    +hasNext() : boolean
}
}

package  "command" {
    interface Comando {
    +ejecutar()
}

class Invocador {
    -historial : List<Comando>
    +ejecutarComando(c: Comando)
}


class CrearReservaCommand {
    -reserva : Reserva
    +ejecutar()
}

class CancelarReservaCommand {
    -reserva : Reserva
    +ejecutar()
}

}

package "Dominio" {
class Mantenimiento {
    -fechaInicio : Date
    -fechaFin : Date
    -estado : String
    -tipoMantenimiento : String
    +cambiarEstado()
    +notificarCambio()
}

class Seguro{
    -fechaVencimiento
    -vehiculo
    -notificaciones : Notificaciones
    +actualizarPago()
    +notificarVencimiento()
}

class Sucursal {
    -nombre : String
    -direccion : String
    -ciudad : String
    -telefono : String
    -horarios : String
    -Vehiculos : List <Vehiculo>
    +agregarVehiculo()
}

class Usuario {
    -nombreUsuario : String
    -correo : String
    -telefono : String
    -contraseña : String
    -tipoUsuario : String
    +actualizar(message: String)
}

class GPS {
    -latitud : double
    -longitud : double
    +obtenerUbicacionActual(): String
    +registrarRuta(ruta: Ruta)
}

class Ruta {
    -origen: String
    -destino: String
    -recorrido: List<String>
    -tiempoTotal: float
}

class Alquiler {
    -fechaInicio: Date
    -fechaFin: Date
    -cliente: Cliente
    -vehiculo: Vehiculo
    -ruta: List <Ruta>
    -notificaciones : Notificaciones
    +notificarInicioAlquiler()
    +notificarFinAlquiler()
    +agregarRuta()
}

class Reserva {
    - cliente : Cliente
    - vehiculo : Vehiculo
    -nombreResponsable : String
    -fechaInicio : Date
    -fechaFin : Date
    -lugarRetiro : String
    -lugarDevolucion : String
    -horaRetiro : String
    -horaDevolucion : String
    -valorTotal : double
    -notificaciones : Notificaciones
    +calcularValorTotal()
    +notificarProximaReserva()
}

class Contrato {
    -fechaContrato : Date
    -estadoVehiculoSalida : String
    -estadoVehiculoRegreso : String
    -condiciones : String
    -montoAPagar : double
}

}

'RELACIONES
'OBSERVER
Administrador ..|> Observador
Cliente ..|> Observador
Reserva ..|> Sujeto
Mantenimiento ..|> Sujeto
Seguro ..|> Sujeto
Sujeto --> Notificaciones : usa
Sujeto --> Observador

'COMMAND
CrearReservaCommand ..|> Comando
CancelarReservaCommand ..|> Comando
Invocador -down-> Comando
CrearReservaCommand --> Reserva
CancelarReservaCommand --> Reserva

'STRATEGY
TarjetaCredito ..|> MetodoPago
TarjetaDebito ..|> MetodoPago
Pago --> MetodoPago : usa

'ITERATOR
IteradorMantenimientos ..|> Iterador
IteradorMantenimientos --> Mantenimiento
Vehiculo ..|> Agregado


'FACTORY
Vehiculo <|-- VehiculoPesado
Vehiculo <|-- VehiculoCasual
Vehiculo <|-- VehiculoDuro

'SINGLETON
VehiculoManager o-- Vehiculo
ReservaManager o-- Reserva


Vehiculo "1" o-- "0..*" Mantenimiento: tiene
Sucursal "1" o-- "0..*" Vehiculo : almacena
Cliente "1" <-- "0..*" Reserva : realiza
Reserva "1" --> "1" Vehiculo : reserva
Reserva "1" *-- "1" Contrato : genera
Contrato "1" *-- "1" Pago : incluye
Usuario <|--- Cliente
Usuario <|--- Administrador
Alquiler o-- Cliente
Alquiler o-- Ruta
GPS --> Ruta : registra


@enduml